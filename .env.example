# Copy to .env and fill in, OR just export the key in your shell.
# Get a key at https://aistudio.google.com/apikey
# Either name works (matches the standard GEMINI_API_KEY ?? GOOGLE_GENERATIVE_AI_API_KEY):
GEMINI_API_KEY=...
