{
  "name": "goal-agent-workbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Learn how a goal agent works — on Gemini — with the Mastra framework and hand-written without it.",
  "scripts": {
    "vanilla": "tsx --env-file-if-exists=.env src/01-vanilla.ts",
    "mastra": "tsx --env-file-if-exists=.env src/02-mastra.ts",
    "bench": "tsx --env-file-if-exists=.env src/03-bench.ts",
    "both": "pnpm vanilla && pnpm mastra",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^1.2.0",
    "@mastra/core": "^0.20.0",
    "ai": "^4.3.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
